rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function userAdminFields() {
      return ['accountStatus', 'updatedByAdminAt', 'updatedByAdminId'];
    }

    function businessAdminFields() {
      return ['category', 'accountStatus', 'updatedByAdminAt', 'updatedByAdminId'];
    }

    function isActiveUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && (!('accountStatus' in get(/databases/$(database)/documents/users/$(userId)).data)
          || get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == 'active');
    }

    function isActiveBusiness(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId))
        && (!('accountStatus' in get(/databases/$(database)/documents/businesses/$(businessId)).data)
          || get(/databases/$(database)/documents/businesses/$(businessId)).data.accountStatus == 'active');
    }


    // A moderated-off USER stays moderated off even if the same uid also owns a
    // business profile. Without this, suspension was trivially escapable: the
    // businesses create rule only checks that the doc id equals the caller's uid, so a
    // suspended user could write businesses/{their own uid} with no accountStatus,
    // satisfy isActiveBusiness(), and be an "active actor" again — regaining every
    // isActiveActor()-gated read, including the venue present lists.
    function isSuspendedUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && ('accountStatus' in get(/databases/$(database)/documents/users/$(uid)).data)
        && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus != 'active';
    }

    // The mirror of the above, and it MUST exist: moderation is applied to whichever
    // doc the account was suspended on (updateUserStatus writes users/{uid};
    // saveBusinessForAdmin writes businesses/{uid}), while isActiveActor() is satisfied
    // by EITHER doc. Vetoing only one side left the other wide open — a suspended
    // business simply signed in as a user, completed onboarding (users create carries no
    // moderation check), and was fully operational again after one document write.
    function isSuspendedBusiness(uid) {
      return exists(/databases/$(database)/documents/businesses/$(uid))
        && ('accountStatus' in get(/databases/$(database)/documents/businesses/$(uid)).data)
        && get(/databases/$(database)/documents/businesses/$(uid)).data.accountStatus != 'active';
    }

    // An account is an actor if EITHER of its profiles is active. Deliberately NOT
    // "suspended on either profile == suspended": a single uid may legitimately hold
    // both a personal and a business profile (see AuthContext), and vetoing on either
    // one bricked the other — suspending a venue silently broke the owner's PERSONAL
    // account (empty map, failing events tab, no chats) while app/index.tsx still
    // routed them into the app rather than the blocked screen, because AuthContext
    // derives status from the signed-in profile only. That is a worse outcome than the
    // hole it was closing.
    //
    // The escape hatch it was meant to shut is closed where it belongs — at the CREATE
    // rules for users/ and businesses/, which refuse to mint a second profile for a uid
    // already suspended on the other one. Suspension cannot be escaped after the fact.
    //
    // RESIDUAL, stated plainly: an account that ALREADY held both profiles before being
    // suspended on one of them keeps the capabilities of the other. Closing that is a
    // moderation-policy decision, not a rules one — the admin tools would need to
    // suspend both documents when the intent is to ban the person, not just the venue.
    function isActiveActor() {
      return request.auth != null
        && (isAdmin() || isActiveUser(request.auth.uid) || isActiveBusiness(request.auth.uid));
    }

    // The participant that is NOT the caller (for a 2-person chat).
    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    // True only if BOTH users have a stored swipe of action 'like' on each other
    // (a real mutual match). Used to gate chat creation server-side so the
    // client-side check in createChatForMatch cannot be bypassed.
    function hasMutualLike(me, other) {
      return exists(/databases/$(database)/documents/swipes/$(me + '_' + other))
        && get(/databases/$(database)/documents/swipes/$(me + '_' + other)).data.action == 'like'
        && exists(/databases/$(database)/documents/swipes/$(other + '_' + me))
        && get(/databases/$(database)/documents/swipes/$(other + '_' + me)).data.action == 'like';
    }

    // The registration doc that pairs with an event join/leave. Join creates it in
    // the SAME write (getAfter sees it), so a client can't inflate attendeeIds/count
    // without a real registration. Leave flips its status (get reads the pre-write
    // doc, which still carries the gender bucket it was counted under — so a gender
    // change between join and leave can't brick unregistration).
    function joinRegData(eventId) {
      return getAfter(/databases/$(database)/documents/registrations/$(request.auth.uid + '_' + eventId)).data;
    }
    function leaveRegData(eventId) {
      return get(/databases/$(database)/documents/registrations/$(request.auth.uid + '_' + eventId)).data;
    }

    // The required fields for a profile to be marked complete. Enforced only at
    // the moment profileComplete becomes true (create or false->true update) — NOT
    // on every later edit, so a normal profile edit is never re-validated.
    function profileFieldsValid() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.gender in ['male', 'female', 'other']
        && request.resource.data.birthday is string && request.resource.data.birthday.size() > 0
        && request.resource.data.city is string && request.resource.data.city.size() > 0
        && request.resource.data.photos is list && request.resource.data.photos.size() >= 2
        && request.resource.data.datingPreference is list
        && request.resource.data.relationshipType is list;
    }

    function otherAttendeeCountsUnchanged(gender) {
      return (gender == 'male' || request.resource.data.get('attendeeCounts', {}).get('male', 0) == resource.data.get('attendeeCounts', {}).get('male', 0))
        && (gender == 'female' || request.resource.data.get('attendeeCounts', {}).get('female', 0) == resource.data.get('attendeeCounts', {}).get('female', 0))
        && (gender == 'other' || request.resource.data.get('attendeeCounts', {}).get('other', 0) == resource.data.get('attendeeCounts', {}).get('other', 0));
    }

    function isJoiningEvent(eventId) {
      let reg = joinRegData(eventId);
      let gender = reg.get('genderField', 'other');
      return reg.get('status', '') == 'registered'
        && reg.get('userId', '') == request.auth.uid
        && reg.get('eventId', '') == eventId
        && !(request.auth.uid in resource.data.get('attendeeIds', []))
        && request.auth.uid in request.resource.data.get('attendeeIds', [])
        && request.resource.data.get('attendeeIds', []).size() == resource.data.get('attendeeIds', []).size() + 1
        && request.resource.data.get('attendeeIds', []).hasAll(resource.data.get('attendeeIds', []))
        && request.resource.data.get('attendeeCount', 0) == resource.data.get('attendeeCount', 0) + 1
        && request.resource.data.get('attendeeCount', 0) <= resource.data.get('capacity', 0)
        && request.resource.data.get('attendeeCounts', {}).get(gender, 0) == resource.data.get('attendeeCounts', {}).get(gender, 0) + 1
        // Defense-in-depth: only a known gender bucket may be incremented.
        && gender in ['male', 'female', 'other']
        // The attendeeCounts map may hold ONLY the three known buckets — a joiner
        // can't inject arbitrary keys into the business's event doc.
        && request.resource.data.get('attendeeCounts', {}).keys().hasOnly(['male', 'female', 'other'])
        && otherAttendeeCountsUnchanged(gender);
    }

    function isLeavingEvent(eventId) {
      let gender = leaveRegData(eventId).get('genderField', 'other');
      return request.auth.uid in resource.data.get('attendeeIds', [])
        && !(request.auth.uid in request.resource.data.get('attendeeIds', []))
        && request.resource.data.get('attendeeIds', []).size() == resource.data.get('attendeeIds', []).size() - 1
        && resource.data.get('attendeeIds', []).hasAll(request.resource.data.get('attendeeIds', []))
        && request.resource.data.get('attendeeCount', 0) == resource.data.get('attendeeCount', 0) - 1
        && request.resource.data.get('attendeeCounts', {}).get(gender, 0) == resource.data.get('attendeeCounts', {}).get(gender, 0) - 1
        // Defense-in-depth: a per-gender bucket can never be driven below zero.
        && request.resource.data.get('attendeeCounts', {}).get(gender, 0) >= 0
        // Only the three known buckets — no foreign-key injection on leave either.
        && request.resource.data.get('attendeeCounts', {}).keys().hasOnly(['male', 'female', 'other'])
        && otherAttendeeCountsUnchanged(gender);
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId)
        || (isActiveActor() && isActiveUser(userId));
      // Mirrors the same check on businesses create: a moderated-off BUSINESS must not
      // be able to mint a user profile for its own uid and walk straight back in.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !isSuspendedBusiness(request.auth.uid)
        && !request.resource.data.keys().hasAny(userAdminFields())
        && (request.resource.data.get('profileComplete', false) != true || profileFieldsValid());
      // A profile may only be marked profileComplete==true when the required
      // fields are actually present — so a UI-bypassing client can't flip the flag
      // and skip onboarding (name/gender/city/birthday/≥2 photos/prefs). Age>=18
      // is validated client-side (rules can't parse a date string).
      // Validate the required fields ONLY when profileComplete flips from
      // not-true to true (the completion moment) — a later edit of an
      // already-complete profile is not re-validated, so removing/replacing a
      // field or dropping a photo is not blocked at the rule layer.
      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == userId
          && isActiveUser(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(userAdminFields())
          && (!(resource.data.get('profileComplete', false) != true
                && request.resource.data.get('profileComplete', false) == true)
              || profileFieldsValid())
          // profileComplete is monotonic (never true -> false). Without this a
          // client could downgrade it, change gender while the freeze is lifted,
          // then re-complete — defeating the gender freeze below.
          && (resource.data.get('profileComplete', false) != true
              || request.resource.data.get('profileComplete', false) == true)
          // Gender is frozen once the profile is complete — otherwise a user could
          // flip gender, check in (freezing the fake gender on the presence entry),
          // and flip back to spoof the per-gender venue tally.
          && (resource.data.get('profileComplete', false) != true
              || request.resource.data.get('gender', '') == resource.data.get('gender', '')));
      allow delete: if false;

      match /adminData/private {
        allow read, write: if isAdmin();
      }
    }

    // Precise per-user GPS coordinates — readable ONLY by the owner or an admin,
    // written only by the owner. Kept out of the public users doc so no one can
    // track another user's real-time location.
    match /user_locations/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /businesses/{businessId} {
      // The business doc is world-readable (map/directory), so owner contact PII
      // (contactName/email) must NOT live here — it goes in the private subdoc
      // below. The owner-write branches forbid those keys on the public doc.
      allow read: if isAdmin() || (request.auth != null && (request.auth.uid == businessId || isActiveActor()));
      // Defence in depth alongside isActiveActor()'s suspension check: a moderated-off
      // user must not be able to mint a business profile for their own uid at all.
      allow create: if isAdmin()
        || (request.auth != null
          && request.auth.uid == businessId
          && !isSuspendedUser(request.auth.uid)
          && !request.resource.data.keys().hasAny(businessAdminFields())
          && !request.resource.data.keys().hasAny(['contactName', 'email']));
      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == businessId
          && isActiveBusiness(businessId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(businessAdminFields())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['contactName', 'email']));
      allow delete: if false;

      // Owner contact PII — readable/writable only by the owner or an admin.
      match /private/{docId} {
        allow read, write: if isAdmin()
          || (request.auth != null && request.auth.uid == businessId);
      }
    }

    match /venues/{venueId} {
      allow read: if isActiveActor();
      allow write: if request.auth != null
        && request.auth.uid == venueId
        && isActiveBusiness(request.auth.uid);
    }

    // The caller's real profile gender (default 'other'). Used to stop a client
    // from checking in under a fabricated gender and skewing the presence tally.
    function profileGender() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('gender', 'other');
    }

    // The venue's authoritative coordinates: a venue's `location` GeoPoint, or a
    // business's `coordinates` GeoPoint. null if neither exists / has coordinates.
    function venueGeo(venueId) {
      return exists(/databases/$(database)/documents/venues/$(venueId))
          && ('location' in get(/databases/$(database)/documents/venues/$(venueId)).data)
        ? get(/databases/$(database)/documents/venues/$(venueId)).data.location
        : (exists(/databases/$(database)/documents/businesses/$(venueId))
              && ('coordinates' in get(/databases/$(database)/documents/businesses/$(venueId)).data)
          ? get(/databases/$(database)/documents/businesses/$(venueId)).data.coordinates
          : null);
    }

    // A check-in's recorded GPS must be within CHECKIN_RADIUS of the venue. Uses the
    // LatLng.distance() geodesic (metres); 300m is a touch wider than the client's
    // 200m circle so a legit client check-in never gets rejected, while still
    // blocking check-ins recorded from afar. (venueGeo also enforces the venue
    // exists and has coordinates.)
    // NOTE: lat/lng are client-supplied, so this is NOT spoof-proof — a raw client
    // could report fake coordinates near the venue. It enforces the honest-client
    // path and raises the bar; true presence attestation would need a trusted
    // server / device integrity signal (deferred).
    function checkinNearVenue() {
      let geo = venueGeo(request.resource.data.venueId);
      return geo != null
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && geo.distance(latlng.value(request.resource.data.lat, request.resource.data.lng)) <= 300;
    }

    match /checkins/{checkinId} {
      // A user may read a single checkin, but may only LIST their OWN — otherwise
      // any active user could enumerate everyone's real-time physical presence.
      // A venue owner (checkins.venueId == their uid) and admins may list their
      // own venue's activity (business dashboard / admin analytics) — a regular
      // user's uid is never a venueId, so they still can't enumerate anyone.
      // get is scoped the same as list — otherwise a stalker could probe
      // checkins/{targetUid}_{venueId} per venue to locate a specific person. No
      // resource==null exemption here (unlike other collections): the app never
      // reads a specific checkin doc directly (only owner/venue queries), and a
      // null-exemption would leak an existence oracle (not-found vs permission-denied
      // distinguishes "is this user checked in here").
      allow get: if isActiveActor()
        && (resource.data.userId == request.auth.uid
            || resource.data.venueId == request.auth.uid
            || isAdmin());
      allow list: if isActiveActor()
        && (resource.data.userId == request.auth.uid
            || resource.data.venueId == request.auth.uid
            || isAdmin());
      // Doc id is bound to uid_venueId (one active checkin per user+venue; blocks
      // random-id spam), expiresAt must be a server-plausible near future, and
      // venueId is immutable on update.
      // gender must match the real profile (no fabricated buckets), and entryId
      // must reference a NOT-yet-existing presence entry — so a caller can never
      // point their check-in at someone else's entry (which would let them delete
      // it). Its expiresAt is a server-plausible near future.
      allow create: if request.auth != null
        && isActiveUser(request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && checkinId == request.auth.uid + '_' + request.resource.data.venueId
        && request.resource.data.gender == profileGender()
        && !exists(/databases/$(database)/documents/venue_presence_entries/$(request.resource.data.entryId))
        // The venue must exist AND the caller's recorded GPS must be AT it — no
        // marking presence somewhere you aren't. (venueGeo enforces existence too.)
        && checkinNearVenue()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(5, 'h');
      // On update only expiresAt may move — venueId/gender/entryId are frozen, so a
      // check-in can't be re-pointed to spawn extra presence entries.
      allow update: if request.auth != null
        && isActiveUser(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.venueId == resource.data.venueId
        && request.resource.data.gender == resource.data.gender
        && request.resource.data.entryId == resource.data.entryId
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(5, 'h');
      // Deleting a check-in requires its presence entry to be deleted in the same
      // write (or it never had one) — so a user can't delete their check-in while
      // leaving an orphaned entry counted, i.e. no self-inflation by churn.
      allow delete: if request.auth != null
        && isActiveUser(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && (!('entryId' in resource.data)
            || getAfter(/databases/$(database)/documents/venue_presence_entries/$(resource.data.entryId)) == null);
    }

    // Venue presence ENTRY: { venueId, gender, expiresAt } — IDENTITY-FREE (no
    // userId). Any active user may LIST them to COUNT per-gender presence per venue
    // globally, WITHOUT being able to learn who is where. Integrity is enforced by
    // coupling each entry to the caller's own check-in (checkins/{uid}_{venueId}).
    match /venue_presence_entries/{entryId} {
      allow read: if isActiveActor();
      allow create: if request.auth != null
        && isActiveUser(request.auth.uid)
        && request.resource.data.keys().hasOnly(['venueId', 'gender', 'expiresAt'])
        && request.resource.data.gender in ['male', 'female', 'other']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(5, 'h')
        && getAfter(/databases/$(database)/documents/checkins/$(request.auth.uid + '_' + request.resource.data.venueId)).data.entryId == entryId
        && getAfter(/databases/$(database)/documents/checkins/$(request.auth.uid + '_' + request.resource.data.venueId)).data.gender == request.resource.data.gender;
      allow update: if request.auth != null
        && isActiveUser(request.auth.uid)
        && get(/databases/$(database)/documents/checkins/$(request.auth.uid + '_' + resource.data.venueId)).data.entryId == entryId
        && request.resource.data.keys().hasOnly(['venueId', 'gender', 'expiresAt'])
        && request.resource.data.venueId == resource.data.venueId
        && request.resource.data.gender == resource.data.gender
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(5, 'h');
      allow delete: if request.auth != null
        && isActiveUser(request.auth.uid)
        // resource == null: deleting an already-gone entry (e.g. it expired and was
        // cleaned) is a no-op and must not error — otherwise a checkout / venue-switch
        // batch that includes the delete would be denied and the user gets stuck.
        && (resource == null
            || get(/databases/$(database)/documents/checkins/$(request.auth.uid + '_' + resource.data.venueId)).data.entryId == entryId);
    }

    // Venue-scoped PRESENCE IDENTITY: venue_presence/{venueId}/present/{uid} =
    // { gender, expiresAt } (doc id = uid). Reveals who is checked in at a venue.
    // READ is OPEN to any active authenticated user (see the note on the rule itself);
    // a collectionGroup('present') read matches no rule and is denied. Carries NO GPS
    // (that stays in the checkin doc, which is readable by its owner, the venue
    // business and admins — not "owner-only", so the venue business can see the exact
    // coordinates its own visitors checked in from).
    match /venue_presence/{venueId}/present/{uid} {
      // OPEN READ — product decision (2026-07-27, owner-directed).
      //
      // Seeing who is at a venue, and being able to contact them, is the core purpose
      // of the product; requiring the viewer to be checked in first made the feature
      // unreachable in practice (you had to already be at the venue to learn whether
      // anyone was there). The co-presence gate that previously stood here has been
      // REMOVED at the owner's instruction.
      //
      // Understand precisely what this means, because it is no longer bounded by
      // anything: any authenticated active user can now read, for ANY venue and with no
      // check-in of their own, the exact list of user IDs physically present there
      // right now — and resolve each to a full profile (name, photos, exact birthday,
      // city) via the users read rule. Iterating the listable /venues and /businesses
      // collections therefore yields a live uid -> venue map of the entire checked-in
      // user base, at zero cost and with no trace.
      //
      // The previous gate did not stop a determined attacker (a check-in is
      // self-mintable from anywhere and uncapped — see the deleted note in git history),
      // but it did stop the CASUAL one, and it made bulk scanning cost a write per
      // venue. That cost is now gone.
      //
      // If this is ever to be bounded without losing the feature, the shape that works
      // is server-side: a Cloud Function that returns the present list for a single
      // venue, rate-limited per caller, rather than direct client reads of the
      // collection. Nothing at the rules layer can express "one venue at a time".
      allow read: if isActiveActor();
      allow create, update: if request.auth != null
        && isActiveUser(request.auth.uid)
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['gender', 'expiresAt'])
        && request.resource.data.gender in ['male', 'female', 'other']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(5, 'h')
        && getAfter(/databases/$(database)/documents/checkins/$(request.auth.uid + '_' + venueId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/checkins/$(request.auth.uid + '_' + venueId)).data.gender == request.resource.data.gender;
      allow delete: if request.auth != null && uid == request.auth.uid;
    }

    match /swipes/{swipeId} {
      // The not-found path is needed by the honest client (checkForMatch reads the
      // possibly-absent reverse swipe), but it must NOT be an unconditional exemption:
      // that would distinguish not-found from permission-denied for ANY id, turning
      // getDoc('A_B') into an oracle for "did A swipe B" over the whole user base
      // (ids are guessable — see the same warning on /checkins). Doc id is
      // {fromUser}_{toUser}, so require the caller to be one of the two parties by ID
      // before the absent doc is readable. Both honest reads qualify: own outgoing
      // ({me}_X) and the reverse check (X_{me}).
      allow get: if isActiveActor()
        && (resource == null
              ? (swipeId.matches(request.auth.uid + '_.*') || swipeId.matches('.*_' + request.auth.uid))
              : (resource.data.fromUser == request.auth.uid
                 || resource.data.toUser == request.auth.uid));
      // List is restricted to your OWN outgoing swipes (fromUser). Allowing a
      // toUser query would let a user enumerate everyone who liked/disliked them.
      // Checking whether a specific person swiped on you is still possible via a
      // targeted `get` (needed for match detection), just not enumeration.
      allow list: if isActiveActor()
        && resource.data.fromUser == request.auth.uid;
      // Bind the doc id to fromUser_toUser and forbid self-swipes. Without the id
      // binding, an attacker could create swipes/{victim}_{attacker} with their
      // OWN fromUser, and hasMutualLike (which keys by doc id) would treat it as
      // the victim's reciprocal like — forging an unsolicited match.
      allow create: if request.auth != null
        && isActiveUser(request.auth.uid)
        && request.resource.data.fromUser == request.auth.uid
        && request.resource.data.action in ['like', 'dislike']
        && swipeId == request.resource.data.fromUser + '_' + request.resource.data.toUser
        && request.resource.data.toUser != request.resource.data.fromUser;
      // A swipe owner may flip their OWN action (e.g. re-liking from a venue profile
      // someone they already swiped in the deck) — fromUser/toUser stay frozen so the
      // id binding and match integrity are preserved.
      allow update: if request.auth != null
        && isActiveUser(request.auth.uid)
        && resource.data.fromUser == request.auth.uid
        && request.resource.data.fromUser == resource.data.fromUser
        && request.resource.data.toUser == resource.data.toUser
        && request.resource.data.action in ['like', 'dislike'];
      allow delete: if false;
    }

    match /matches/{matchId} {
      // No resource == null exemption: nothing in the app reads this collection, so
      // the not-found path is never needed by an honest client — and granting it
      // would distinguish not-found from permission-denied, leaking whether a given
      // match doc exists.
      allow read: if isActiveActor() && request.auth.uid in resource.data.users;
      allow create: if false;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      // A transaction pre-read (tx.get) of a not-yet-existing chat — as
      // createChatForMatch does — must return not-found rather than error on
      // resource.data and deny the whole transaction. But the exemption is scoped to
      // the caller's own ids: chatId is the sorted participant pair, so an
      // unconditional exemption would let anyone probe getDoc('{A}_{B}') and tell
      // not-found from permission-denied — i.e. learn whether A and B are matched.
      allow read: if isActiveActor()
        && (resource == null
              ? (chatId.matches(request.auth.uid + '_.*') || chatId.matches('.*_' + request.auth.uid))
              : request.auth.uid in resource.data.participants);
      // Chat creation requires a real, server-verified mutual match (both swipe
      // docs are 'like'). This closes the unsolicited-chat / spam vector where a
      // client could otherwise create a chat with anyone by listing itself.
      allow create: if request.auth != null
        && isActiveUser(request.auth.uid)
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && hasMutualLike(request.auth.uid, otherParticipant(request.resource.data.participants))
        // Doc id must be one of the two orderings of the actual participants, so a
        // matched peer can't flood the victim's chat list with junk chats at random
        // ids (bounded to at most 2 docs per pair). Accept EITHER order so an
        // already-installed client that writes an unsorted participants array (with
        // a sorted id) isn't rejected; new clients write the canonical sorted pair.
        && (chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
            || chatId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0])
        // Same field constraints as update, applied on CREATE — so a matched peer
        // can't seed a chat with a forged lastSenderId/reads or unbounded lastMessage.
        && request.resource.data.keys().hasOnly(['participants', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'reads'])
        && (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000))
        && (!('lastSenderId' in request.resource.data) || request.resource.data.lastSenderId == request.auth.uid)
        && (!('lastMessageAt' in request.resource.data) || request.resource.data.lastMessageAt == request.time)
        && (!('reads' in request.resource.data) || request.resource.data.reads.keys().hasOnly([request.auth.uid]));
      // Participants are immutable, and only chat metadata may be updated — this
      // blocks participant injection (adding a stranger) or removal (silencing).
      // Only chat metadata may change; participants are immutable. Additionally:
      // a caller may only stamp its OWN reads.{uid} (not forge the other user's
      // read status), lastSenderId can only be the caller (can't fake a message
      // "from" the other user), and lastMessageAt must be the server clock.
      allow update: if request.auth != null
        && isActiveUser(request.auth.uid)
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'reads'])
        && (!('reads' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.reads.diff(resource.data.get('reads', {})).affectedKeys().hasOnly([request.auth.uid]))
        && (!('lastSenderId' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastSenderId == request.auth.uid)
        && (!('lastMessageAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastMessageAt == request.time)
        && (!('lastMessage' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000));

      match /messages/{messageId} {
        allow read: if isActiveActor()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && isActiveUser(request.auth.uid)
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.read == false
          && request.resource.data.timestamp == request.time
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'read', 'timestamp']);
        allow update, delete: if false;
      }
    }

    match /events/{eventId} {
      // ACCEPTED RISK — PREDICTIVE LOCATION DISCLOSURE (decision: 2026-07-23).
      // An event doc carries `attendeeIds`, and this rule makes the whole doc readable
      // by ANY active user. Firestore has no field-level read control, so a raw client
      // can run getDocs(query(events, where('venueId','==',X))) and learn, per event,
      // exactly WHO will be at that address and WHEN — then resolve each uid to a full
      // profile via the users read rule. This needs no check-in, no proximity claim and
      // no forged document.
      // The UI now SURFACES these identities deliberately (owner decision, 2026-07-27):
      // app/(tabs)/venue/[venueId].tsx renders the registered users as a tappable grid,
      // and app/(tabs)/events/index.tsx shows a per-event "מי מגיע?" list. An earlier
      // version of this note claimed the screen showed a count only — that mitigation
      // no longer exists, so the disclosure is live in the product, not just latent in
      // the data.
      // Closing it properly means moving attendeeIds into a subcollection with its own
      // rules. Deferred because the field is load-bearing: src/services/events.ts
      // (registration + venue counts) and src/services/swipes.ts (candidate-deck build)
      // both read it, and existing events would need migrating.
      allow read: if isActiveActor();
      allow create: if request.auth != null
        && isActiveBusiness(request.auth.uid)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.venueId == request.auth.uid
        && request.resource.data.attendeeCount == 0
        && request.resource.data.attendeeIds == []
        && request.resource.data.attendeeCounts.male == 0
        && request.resource.data.attendeeCounts.female == 0
        && request.resource.data.attendeeCounts.other == 0;
      allow update: if request.auth != null && (
        (resource.data.createdBy == request.auth.uid
          && isActiveBusiness(request.auth.uid)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.venueId == resource.data.venueId
          && !('attendeeCount' in request.resource.data.diff(resource.data).affectedKeys())
          && !('attendeeCounts' in request.resource.data.diff(resource.data).affectedKeys())
          && !('attendeeIds' in request.resource.data.diff(resource.data).affectedKeys())
          // Capacity can never drop below people already registered — enforced
          // against the pre-write attendeeCount so a concurrent join can't slip
          // through the client-side check.
          && request.resource.data.get('capacity', 0) >= resource.data.get('attendeeCount', 0)
          // dateTime can't be moved into the past — that would hide the event from
          // every user surface while leaving registrations stranded (no leave path).
          && (!('dateTime' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.dateTime > request.time))
        ||
        (isActiveUser(request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['attendeeCount', 'attendeeCounts', 'attendeeIds'])
          // Joining requires the owning business to be active; leaving stays
          // ungated so a user is never stranded on a moderated-off event.
          && ((isJoiningEvent(eventId) && isActiveBusiness(resource.data.venueId))
              || isLeavingEvent(eventId)))
      );
      allow delete: if false;
    }

    match /registrations/{regId} {
      // Scope get to the owner/admin — otherwise any active user could read any
      // registration (userId, eventId, gender, status) by its guessable doc id.
      // registerForEvent's transaction pre-reads the (not-yet-existing) registration
      // doc, which must return not-found rather than error and deny the whole
      // registration. Scoped to the caller's own ids (regId is {uid}_{eventId}): an
      // unconditional exemption would distinguish not-found from permission-denied and
      // so reveal whether any given user is registered for any given event.
      allow get: if isActiveActor()
        && (resource == null
              ? (regId.matches(request.auth.uid + '_.*') || isAdmin())
              : (isAdmin() || resource.data.userId == request.auth.uid));
      allow list: if isActiveActor()
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && isActiveUser(request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && regId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.genderField == profileGender()
        // genderField must be a KNOWN bucket — profileGender() returns the raw
        // users.gender, which for an incomplete profile is an unvalidated string;
        // without this, a raw-client user could register with a junk gender and
        // spawn an attendeeCounts.<junk> key that inflates the total vs m+f+other.
        && request.resource.data.genderField in ['male', 'female', 'other']
        // Can't register for an event whose owning business is suspended/blocked —
        // a moderated-off business must not keep collecting registrations.
        && isActiveBusiness(get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.venueId);
      // eventId is immutable, and genderField is IMMUTABLE (must equal its own prior
      // value) — it's the bucket a user was counted under at join, so it must never
      // change, or a leave would decrement a different bucket than the join
      // incremented (driving a per-gender count negative). Freezing it here — rather
      // than re-pinning to profileGender() — also closes the pre-completion window
      // where gender is still mutable and could be flipped then re-pinned.
      allow update: if request.auth != null
        && isActiveUser(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.get('genderField', '') == resource.data.get('genderField', '')
        // A cancelled->registered RE-JOIN must also respect business moderation
        // (a plain set() on an existing reg is an UPDATE, so the create-time gate
        // was bypassable). Leaving (status != 'registered') stays allowed.
        && (request.resource.data.get('status', '') != 'registered'
            || isActiveBusiness(get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.venueId));
      allow delete: if false;
    }

    match /debug_logs/{logId} {
      // Was world-readable (read: if true) — logs can carry UIDs/device/error
      // details, so restrict reads to admins.
      allow read: if isAdmin();
      // isActiveActor(), not isActiveUser(): a BUSINESS account has businesses/{uid}
      // and no users/{uid}, so isActiveUser() denied every log write from the entire
      // business side of the app — business onboarding, event creation and event
      // management produced no diagnostics at all. Admins likewise.
      // (Events logged before the account doc exists — mid-signup — still cannot be
      // written by any variant of this rule without dropping the account check
      // altogether; those are covered by the console mirror in debugLog, read via
      // `adb logcat`, rather than by weakening this gate.)
      allow create: if isActiveActor()
        && request.resource.data.uid == request.auth.uid
        // Whitelist fields + cap sizes so an active user can't flood the collection
        // with arbitrary/oversized documents.
        && request.resource.data.keys().hasOnly(['scope', 'message', 'payload', 'uid', 'timestamp'])
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2000))
        && (!('scope' in request.resource.data) || (request.resource.data.scope is string && request.resource.data.scope.size() <= 200))
        // payload must be null or a bounded string — the client serializes it to a
        // capped string; this stops a raw client writing a ~1 MiB map/array/string.
        && (!('payload' in request.resource.data)
            || request.resource.data.payload == null
            || (request.resource.data.payload is string && request.resource.data.payload.size() <= 8000));
      allow update, delete: if false;
    }

    match /admins/{adminId} {
      allow read: if (request.auth != null && request.auth.uid == adminId) || isAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      // Anchor audit entries to the acting admin and the server clock so the
      // trail can't be back/forward-dated or attributed to another admin.
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
