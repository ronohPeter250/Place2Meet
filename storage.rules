rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isActiveUser(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId))
        && (!('accountStatus' in firestore.get(/databases/(default)/documents/users/$(userId)).data)
          || firestore.get(/databases/(default)/documents/users/$(userId)).data.accountStatus == 'active');
    }

    function isActiveBusiness(businessId) {
      return firestore.exists(/databases/(default)/documents/businesses/$(businessId))
        && (!('accountStatus' in firestore.get(/databases/(default)/documents/businesses/$(businessId)).data)
          || firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.accountStatus == 'active');
    }


    function isActiveActor() {
      return request.auth != null && (isAdmin() || isActiveUser(request.auth.uid) || isActiveBusiness(request.auth.uid));
    }

    match /users/{userId}/photos/{photoId} {
      allow read: if isActiveActor();
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isActiveUser(userId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if (request.auth != null
        && request.auth.uid == userId
        && isActiveUser(userId)) || isAdmin();
    }

    match /businesses/{businessId}/{allPaths=**} {
      allow read: if isActiveActor();
      allow write: if ((request.auth != null && request.auth.uid == businessId && isActiveBusiness(businessId)) || isAdmin())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if (request.auth != null && request.auth.uid == businessId && isActiveBusiness(businessId)) || isAdmin();
    }

    match /events/{eventId}/{allPaths=**} {
      allow read: if isActiveActor();
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.createdBy == request.auth.uid
        && isActiveBusiness(request.auth.uid);
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.createdBy == request.auth.uid
        && isActiveBusiness(request.auth.uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
